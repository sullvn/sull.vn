{
  "name": "sull.vn",
  "type": "module",
  "version": "0.0.2",
  "imports": {
    "#rust/*": "./target/wasm-bindgen/*/index.js"
  },
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "dev": "astro dev",
    "format": "biome format --write . && cargo fmt",
    "preview": "astro preview",
    "test": "pnpm test:actionlint && pnpm test:actions-lock && pnpm test:cargo && pnpm test:astro && pnpm test:biome && pnpm test:playwright && pnpm test:unit",
    "test:actionlint": "actionlint",
    "test:actions-lock": "gh-actions-lock --verify",
    "test:astro": "astro check",
    "test:cargo": "export CARGO_BUILD_WARNINGS=deny && cargo fmt --check && cargo clippy --all-targets && cargo test",
    "test:biome": "biome check .",
    "test:playwright": "playwright test",
    "test:unit": "node --test"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/svelte": "^9.1.2",
    "astro": "^7.4.7",
    "katex": "^0.19.1",
    "lightningcss": "^1.33.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "svelte": "^5.57.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/language-server": "^2.17.3",
    "@playwright/test": "1.64.1",
    "svelte-language-server": "^0.18.6",
    "tinyglobby": "^0.2.17",
    "typescript-language-server": "^6.0.3",
    "wrangler": "^4.158.0"
  }
}
