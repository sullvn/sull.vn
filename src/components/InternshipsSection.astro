---
import ResumeSection from './ResumeSection.astro';
import Heading from './Heading.astro';
import Prose from './Prose.astro';

interface Props {
  jobs: Array<{
    company: string;
    time: string;
  }>;
}

const { jobs } = Astro.props;
---

<ResumeSection>
  <header>
    {jobs.map(job => (
      <div class="resume-role">
        <Heading level={2} class="resume-heading"><Fragment set:html={job.company} /></Heading>
        <time>{job.time}</time>
      </div>
    ))}
  </header>
  <Prose class="resume-description"><slot /></Prose>
</ResumeSection>

<style>
  header {
    gap: 2rem;
  }
</style>
