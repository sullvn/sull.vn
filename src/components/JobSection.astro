---
import ResumeSection from './ResumeSection.astro';

interface Props {
  company: string;
  time: string;
}

const { company, time } = Astro.props;
---

<ResumeSection>
  <header>
    <!-- biome-ignore lint/a11y/useHeadingContent: content provided via set:html -->
    <h2 set:html={company} />
    <time>{time}</time>
  </header>
  <p><slot /></p>
</ResumeSection>
