---
import ResumeSection from './ResumeSection.astro';
import Heading from './Heading.astro';
import Prose from './Prose.astro';

interface Props {
  company: string;
  time: string;
}

const { company, time } = Astro.props;
---

<ResumeSection>
  <header class="resume-role">
    <Heading level={2} class="resume-heading"><Fragment set:html={company} /></Heading>
    <time>{time}</time>
  </header>
  <Prose class="resume-description"><slot /></Prose>
</ResumeSection>
