---
import ResumeSection from './ResumeSection.astro';
import Heading from './Heading.astro';

interface Props {
  school: string;
  time: string;
  degree: string;
}

const { school, time, degree } = Astro.props;
---

<ResumeSection>
  <header>
    <Heading level={2} class="resume-heading"><Fragment set:html={school} /></Heading>
    <div>
      <strong>{degree}</strong>
      <time>{time}</time>
    </div>
  </header>
</ResumeSection>

<style>
  header {
    gap: 1rem;
  }

  div {
    display: flex;
    flex-direction: column;
    gap: .5rem;
  }
</style>
