---
import Base from '../layouts/Base.astro'
import { greet, parse_byte, sum } from '#rust/smoke'

let error = ''
try {
  parse_byte('300')
} catch (e) {
  error = String(e)
}
---

<Base title="Rust wasm test" description="Rust compiled to WebAssembly, at build time and in the browser">
  <p>{greet('Astro')}</p>
  <p>{sum(new Float64Array([1.5, 2.5]))}</p>
  <p>{error}</p>
  <button id="counter" type="button">Count: 0</button>
  <button id="worker-counter" type="button">Worker count: 0</button>
</Base>

<script>
  import { Counter } from '#rust/smoke'

  const counter = new Counter()
  const button = document.querySelector('#counter')
  button?.addEventListener('click', () => {
    counter.increment()
    button.textContent = `Count: ${counter.value}`
  })
</script>

<script>
  import type { FromWorker, ToWorker } from '../components/smoke-counter/messages.ts'

  const worker = new Worker(new URL('../components/smoke-counter/worker.ts', import.meta.url), {
    type: 'module',
  })
  const button = document.querySelector('#worker-counter')

  worker.addEventListener('message', ({ data }: MessageEvent<FromWorker>) => {
    if (button) button.textContent = `Worker count: ${data.value}`
  })
  button?.addEventListener('click', () => {
    worker.postMessage({ type: 'increment' } satisfies ToWorker)
  })
</script>
